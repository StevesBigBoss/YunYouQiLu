# ============================================================
# 云游齐鲁（yunyouqilu）本地环境变量模板
# 使用方法：复制本文件为 .env 并填写真实值
#   copy .env.example .env
# 注意：.env 已被 .gitignore 忽略，禁止提交到 git
# ============================================================

# MySQL 数据库密码（原 settings.py / spider.py 中的明文密码请填到这里）
# settings.py 读取: os.getenv("DB_PASSWORD")
# spider.py 读取:   os.getenv("DB_PASSWORD")
DB_PASSWORD=your_mysql_root_password

# Django SECRET_KEY（必须使用随机密钥，勿用旧明文值）
# 生成方法（Django 环境内执行）：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 或在线随机生成器（>=50 位随机字符）
# settings.py 读取: os.getenv("SECRET_KEY")
SECRET_KEY=your_random_secret_key_at_least_50_chars

# 抖音/今日头条抓取 Cookie（可选；留空则请求不带 Cookie）
# spider.py 读取: os.getenv("TIKTOK_COOKIE", "")
# 格式示例：ttwid=xxx; msToken=xxx; csrftoken=xxx
TIKTOK_COOKIE=

# Django 调试模式（可选；默认 False，生产必须 False）
# settings.py 读取: os.getenv("DEBUG", "False") == "True"
DEBUG=False

# 允许访问的主机名，逗号分隔（可选；默认仅本机 127.0.0.1,localhost）
# 部署时填写服务器域名或公网 IP，如：ALLOWED_HOSTS=yourdomain.com,47.92.xx.xx
# settings.py 读取: os.getenv("ALLOWED_HOSTS", "127.0.0.1,localhost")
ALLOWED_HOSTS=127.0.0.1,localhost
